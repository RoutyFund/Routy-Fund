pragma solidity ^0.8.24; interface IAssetRegistry{function approved(address)external view returns(bool);} contract ProtocolLauncher{enum Policy{WEIGHTED_RAFFLE,EQUAL_LOTTERY,PRO_RATA}struct Route{address creator;address targetAsset;Policy policy;uint64 createdAt;}IAssetRegistry public immutable registry;mapping(address=>Route)public routes;event RouteRegistered(address indexed token,address indexed creator,address indexed targetAsset,Policy policy);constructor(address r){require(r!=address(0),"ZERO_REGISTRY");registry=IAssetRegistry(r);}function register(address token,address asset,Policy policy)external{require(token!=address(0),"ZERO_TOKEN");require(routes[token].creator==address(0),"EXISTS");require(registry.approved(asset),"ASSET_NOT_APPROVED");routes[token]=Route(msg.sender,asset,policy,uint64(block.timestamp));emit RouteRegistered(token,msg.sender,asset,policy);}}