pragma solidity ^0.8.24; contract RaffleDistributor{struct Round{bytes32 root;bytes32 randomness;address winner;uint64 challengeEnds;bool finalized;}address public immutable operator;mapping(uint256=>Round)public rounds;constructor(address o){require(o!=address(0),"ZERO_OPERATOR");operator=o;}modifier onlyOperator(){require(msg.sender==operator,"NOT_OPERATOR");_;}function publish(uint256 id,bytes32 root,uint64 ends)external onlyOperator{require(rounds[id].root==0&&ends>block.timestamp,"BAD_ROUND");rounds[id].root=root;rounds[id].challengeEnds=ends;}function recordRandomness(uint256 id,bytes32 random)external onlyOperator{require(block.timestamp>=rounds[id].challengeEnds&&random!=0,"NOT_READY");rounds[id].randomness=random;}function finalize(uint256 id,address winner)external onlyOperator{Round storage r=rounds[id];require(r.randomness!=0&&!r.finalized&&winner!=address(0),"NOT_READY");r.winner=winner;r.finalized=true;}}