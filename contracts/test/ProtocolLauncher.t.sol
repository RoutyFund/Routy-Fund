pragma solidity ^0.8.24; import "../src/AssetRegistry.sol"; import "../src/ProtocolLauncher.sol"; import "../src/AssetVaultFactory.sol"; import "../src/FeeRouterFactory.sol"; import "../src/SwapExecutor.sol";
contract MockPons {IPonsFactory.Launch internal l;function seed(address token,address creator,address pair)external{l=IPonsFactory.Launch(token,address(2),creator,creator,pair,0,0,0,0,false,0,0,0,0,true);}function getLaunchedToken(address)external view returns(IPonsFactory.Launch memory){return l;}}
contract MockTargetAsset{}
contract ProtocolLauncherTest {
function testRejectsUnapprovedAsset()public{AssetRegistry r=new AssetRegistry(address(this));MockPons p=new MockPons();address token=address(0xBEEF);p.seed(token,address(this),address(0));SwapExecutor x=new SwapExecutor(address(this));AssetVaultFactory vf=new AssetVaultFactory(address(this));FeeRouterFactory rf=new FeeRouterFactory(address(this));ProtocolLauncher l=new ProtocolLauncher(address(r),address(p),address(vf),address(rf),address(0xE5C0),address(0xCAFE),address(x));vf.setLauncher(address(l));rf.setLauncher(address(l));x.setLauncher(address(l));try l.provision(token,address(0xA11CE),ProtocolLauncher.Policy.PRO_RATA){revert("SHOULD_REVERT");}catch{}}
function testProvisionApprovedPonsToken()public{AssetRegistry r=new AssetRegistry(address(this));address asset=address(new MockTargetAsset());r.setApproved(asset,true);MockPons p=new MockPons();address token=address(0xBEEF);p.seed(token,address(this),address(0));SwapExecutor x=new SwapExecutor(address(this));AssetVaultFactory vf=new AssetVaultFactory(address(this));FeeRouterFactory rf=new FeeRouterFactory(address(this));ProtocolLauncher l=new ProtocolLauncher(address(r),address(p),address(vf),address(rf),address(0xE5C0),address(0xCAFE),address(x));vf.setLauncher(address(l));rf.setLauncher(address(l));x.setLauncher(address(l));(address vault,address router)=l.provision(token,asset,ProtocolLauncher.Policy.PRO_RATA);require(vault!=address(0)&&router!=address(0),"NOT_PROVISIONED");(address creator,address target,,address storedVault,address storedRouter,,)=l.routes(token);require(creator==address(this)&&target==asset&&storedVault==vault&&storedRouter==router,"BAD_ROUTE");}}
